---
interface Props {
  whatsapp: string
}

const { whatsapp } = Astro.props
const currentPath = Astro.url.pathname

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/catalog', label: 'Katalog' },
  { href: '/about', label: 'Tentang' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Kontak' }
]
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="container-main">
    <div class="flex items-center justify-between h-14 md:h-16">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/images/logo.png" alt="WEXPLORE" class="h-7 md:h-8 w-auto" />
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
          return (
            <a
              href={link.href}
              class:list={[
                'px-4 py-2 text-sm font-medium transition-colors duration-200 rounded-lg',
                isActive
                  ? 'text-white bg-white/10'
                  : 'text-neutral-400 hover:text-white hover:bg-white/10'
              ]}
            >
              {link.label}
            </a>
          )
        })}
      </nav>

      <div class="flex items-center gap-3">
        <a href="/cart" class="relative p-2.5 text-neutral-400 hover:text-white transition-colors" aria-label="Keranjang">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="21" r="1"/>
            <circle cx="19" cy="21" r="1"/>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
          </svg>
          <span id="cart-badge" class="cart-badge hidden">0</span>
        </a>

        <a
          href={`https://wa.me/${whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-whatsapp hover:bg-[#20BD5A] rounded-lg transition-colors"
          onclick="window.trackEvent('whatsapp_click')"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.432-9.884 9.884-9.884 2.634 0 5.115 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat
        </a>

        <button id="mobile-menu-btn" class="md:hidden p-2 text-neutral-400 hover:text-white transition-colors" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="12" y2="12"/>
            <line x1="4" x2="20" y1="6" y2="6"/>
            <line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="fixed inset-0 z-40 hidden">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-md" id="mobile-menu-overlay"></div>
    <div class="absolute right-0 top-0 bottom-0 w-[min(320px,85vw)] bg-[var(--surface)] border-l border-[var(--border)] transform translate-x-full transition-transform duration-400" id="mobile-menu-panel">
      <div class="p-6 flex flex-col h-full">
        <div class="flex justify-between items-center mb-10">
          <img src="/images/logo.png" alt="WEXPLORE" class="h-7 w-auto" />
          <button id="mobile-menu-close" class="p-2 text-neutral-400 hover:text-white transition-colors" aria-label="Tutup Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"/>
              <path d="m6 6 12 12"/>
            </svg>
          </button>
        </div>
        <nav class="flex flex-col gap-1">
          {navLinks.map(link => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
            return (
              <a
                href={link.href}
                class:list={[
                  'text-lg font-medium py-3 px-4 rounded-lg transition-colors',
                  isActive
                    ? 'text-white bg-white/10'
                    : 'text-neutral-400 hover:text-white hover:bg-white/10'
                ]}
              >
                {link.label}
              </a>
            )
          })}
        </nav>
        <div class="mt-auto pt-6">
          <a
            href={`https://wa.me/${whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full py-3.5 bg-whatsapp hover:bg-[#20BD5A] text-white font-semibold rounded-lg transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.432-9.884 9.884-9.884 2.634 0 5.115 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Chat Admin
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function getCartCount(): number {
    try {
      const data = localStorage.getItem('wexplore_cart')
      if (!data) return 0
      const cart = JSON.parse(data)
      return cart.reduce((sum: number, item: { qty: number }) => sum + item.qty, 0)
    } catch {
      return 0
    }
  }

  function updateCartBadge() {
    const badge = document.getElementById('cart-badge')
    if (!badge) return
    const count = getCartCount()
    if (count > 0) {
      badge.textContent = count.toString()
      badge.classList.remove('hidden')
    } else {
      badge.classList.add('hidden')
    }
  }

  updateCartBadge()
  window.addEventListener('cartUpdated', updateCartBadge)

window.addEventListener('scroll', () => {
  const isDesktop = window.innerWidth >= 768

  if (window.scrollY > 60) {
    header?.classList.add(
      'bg-[var(--surface)]/90',
      'border-b',
      'border-[var(--border)]'
    )

    if (isDesktop) {
      header?.classList.add('backdrop-blur-xl')
    }
  } else {
    header?.classList.remove(
      'bg-[var(--surface)]/90',
      'backdrop-blur-xl',
      'border-b',
      'border-[var(--border)]'
    )
  }
})

  const mobileMenuBtn = document.getElementById('mobile-menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const mobileMenuPanel = document.getElementById('mobile-menu-panel')
  const mobileMenuClose = document.getElementById('mobile-menu-close')
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay')

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden')
    document.body.style.overflow = 'hidden'
    setTimeout(() => {
      mobileMenuPanel?.classList.remove('translate-x-full')
    }, 10)
  }

  function closeMobileMenu() {
    mobileMenuPanel?.classList.add('translate-x-full')
    setTimeout(() => {
      mobileMenu?.classList.add('hidden')
      document.body.style.overflow = ''
    }, 300)
  }

  mobileMenuBtn?.addEventListener('click', openMobileMenu)
  mobileMenuClose?.addEventListener('click', closeMobileMenu)
  mobileMenuOverlay?.addEventListener('click', closeMobileMenu)
</script>
