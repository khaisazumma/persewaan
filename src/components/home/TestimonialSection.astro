---
const testimonials = [
  { text: 'Peralatannya lengkap dan bersih. Pendakian ke Semeru jadi lebih nyaman!', name: 'Rizki A.', location: 'Surabaya' },
  { text: 'Harga terjangkau, kondisi barang bagus. Recommended banget!', name: 'Dina S.', location: 'Sidoarjo' },
  { text: 'Proses sewanya gampang banget, admin fast respon. Pasti balik lagi!', name: 'Fajar M.', location: 'Gresik' },
  { text: 'Tas carrier-nya nyaman dipakai naik Rinjani. Makasih WEXPLORE!', name: 'Sari W.', location: 'Surabaya' },
  { text: 'Lengkap banget pilihannya. Dari tenda sampai sleeping bag ada semua.', name: 'Bagas P.', location: 'Malang' }
]
---

<section class="py-20 md:py-28">
  <div class="container-main">
    <div class="max-w-2xl mx-auto text-center mb-16 fade-up">
      <span class="section-label mb-4 block">Testimoni</span>
      <h2 class="heading-2 text-[var(--text-white)] mb-4">Apa Kata Para Petualang?</h2>
      <p class="body-text">
        Pendapat jujur dari komunitas WEXPLORE yang telah menjelajahi Indonesia
      </p>
    </div>

    <div class="md:hidden overflow-x-auto hide-scrollbar -mx-4 px-4">
      <div class="flex gap-4 min-w-max">
        {testimonials.map((item, index) => (
          <div
            class="card p-5 w-72 shrink-0 fade-up"
            style={`transition-delay: ${index * 50}ms`}
          >
            <div class="flex items-center gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)]">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              ))}
            </div>
            <p class="text-sm text-[var(--text-white)]/90 mb-5 leading-relaxed">"{item.text}"</p>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-[var(--btn)]/20 flex items-center justify-center">
                <span class="text-sm font-semibold text-[var(--btn)]">{item.name.charAt(0)}</span>
              </div>
              <div>
                <div class="text-sm font-medium text-[var(--text-white)]">{item.name}</div>
                <div class="text-xs text-[var(--text-muted)]">{item.location}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hidden md:grid md:grid-cols-3 gap-6">
      {testimonials.slice(0, 3).map((item, index) => (
        <div
          class="card p-6 fade-up"
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="flex items-center gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)]">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-[var(--text-white)]/90 mb-5 leading-relaxed">"{item.text}"</p>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-[var(--btn)]/20 flex items-center justify-center">
              <span class="text-sm font-semibold text-[var(--btn)]">{item.name.charAt(0)}</span>
            </div>
            <div>
              <div class="text-sm font-medium text-[var(--text-white)]">{item.name}</div>
              <div class="text-xs text-[var(--text-muted)]">{item.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
