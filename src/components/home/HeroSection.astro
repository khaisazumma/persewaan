---
interface Props {
  whatsapp: string
}

const { whatsapp } = Astro.props

const heroImages = [
  {
    src: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1920&q=80',
    alt: 'Mountain landscape'
  },
  {
    src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80',
    alt: 'Alpine adventure'
  },
  {
    src: 'https://images.unsplash.com/photo-1519681393784-d120267933ba?w=1920&q=80',
    alt: 'Starry mountain night'
  }
]
---

<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden isolate">

  <!-- Background Carousel -->
  <div id="hero-carousel" class="absolute inset-0 bg-black">
    {heroImages.map((img, index) => (
      <div
        class:list={[
          'absolute inset-0 transition-opacity duration-1000 ease-in-out',
          index === 0 ? 'opacity-100' : 'opacity-0'
        ]}
        data-slide={index}
      >
        <img
          src={img.src}
          alt={img.alt}
          class="w-full h-full object-cover"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />

        <div class="absolute inset-0 bg-black/40"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0f1712] via-[#0f1712]/60 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#0f1712]/80 via-transparent to-[#0f1712]/80"></div>
      </div>
    ))}
  </div>

  <!-- Content -->
  <div class="relative z-30 container-main pt-20 pb-16 hero-content">
    <div class="max-w-3xl mx-auto text-center">

      <div class="fade-up mb-6">
        <span class="section-label">
          Rental Outdoor Surabaya
        </span>
      </div>

      <h1
        class="fade-up heading-1 text-white mb-6"
        style="transition-delay:100ms"
      >
        Explore More, <br />
        <span class="text-[#c4b998]">
          Worry Less.
        </span>
      </h1>

      <p
        class="fade-up body-text max-w-xl mx-auto text-neutral-300 mb-10"
        style="transition-delay:200ms"
      >
        Sewa perlengkapan outdoor premium untuk hiking, camping,
        dan pendakian. Tanpa perlu beli, pakai saja yang terbaik.
      </p>

      <div
        class="fade-up flex flex-col sm:flex-row gap-3 justify-center"
        style="transition-delay:300ms"
      >
        <a href="/catalog" class="btn-primary text-base">
          Jelajahi Katalog

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>

        <a
          href={`https://wa.me/${whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary text-base"
          onclick="window.trackEvent('whatsapp_click')"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>

          Chat Admin
        </a>
      </div>

    </div>
  </div>

  <!-- Dots -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-40 flex gap-2">
    {heroImages.map((_, index) => (
      <button
        class="slide-dot w-2.5 h-2.5 rounded-full bg-white/30 transition-all duration-300"
        aria-label={`Slide ${index + 1}`}
      />
    ))}
  </div>

</section>

<style>
  .hero-content {
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
  }

  #hero-carousel {
    transform: translateZ(0);
    will-change: opacity;
  }

  #hero-carousel > div {
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: opacity;
  }
</style>

<script>
  const slides = document.querySelectorAll('#hero-carousel > div')
  const dots = document.querySelectorAll('.slide-dot')

  let currentSlide = 0
  let interval

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.style.opacity = i === index ? '1' : '0'
    })

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-white')
        dot.classList.remove('bg-white/30')
      } else {
        dot.classList.remove('bg-white')
        dot.classList.add('bg-white/30')
      }
    })

    currentSlide = index
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % slides.length)
  }

  function startAutoplay() {
    interval = setInterval(nextSlide, 5000)
  }

  function stopAutoplay() {
    clearInterval(interval)
  }

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      stopAutoplay()
      showSlide(index)
      startAutoplay()
    })
  })

  showSlide(0)
  startAutoplay()
</script>