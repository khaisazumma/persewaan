---
import Layout from '../layouts/Layout.astro'

export const prerender = true

const timeline = [
  { year: '2017-2020', event: 'Memulai perjalanan mendaki dan menjelajahi berbagai gunung di Indonesia. Setiap perjalanan menjadi pengalaman berharga dalam memahami kebutuhan perlengkapan outdoor.' },
  { year: '2021-2023', event: 'Mencoba berbagai jenis dan merek perlengkapan outdoor untuk menemukan gear yang nyaman, aman, dan layak digunakan di berbagai kondisi alam. ' },
  { year: '2024-2025', event: 'Berawal dari pengalaman pribadi, muncul keinginan untuk menghadirkan layanan sewa perlengkapan outdoor yang memudahkan siapa saja menikmati alam tanpa harus memiliki semua gear sendiri. ' },
  { year: '2026', event: 'WEXPLORE resmi didirikan sebagai penyedia jasa sewa perlengkapan outdoor yang mengutamakan kualitas, kemudahan, dan pelayanan terbaik. ' }
]

const values = [
  { icon: 'mountain', title: 'Passion', desc: 'Kecintaan pada alam bebas mendorong kami memberikan yang terbaik' },
  { icon: 'shield', title: 'Trust', desc: 'Kepercayaan pelanggan adalah aset terpenting bagi kami' },
  { icon: 'zap', title: 'Speed', desc: 'Proses cepat dan responsif untuk kemudahan Anda' },
  { icon: 'award', title: 'Quality', desc: 'Peralatan berkualitas tinggi untuk keamanan petualangan' }
]

const icons: Record<string, string> = {
  mountain: '<path d="m8 3 4 8 5-5 5 15H2L8 3z"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-2.04 5.37h6.06a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l2.04-5.37H4z"/>',
  award: '<path d="m12 3 1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275Z"/>'
}
---

<Layout title="Tentang Kami — WEXPLORE">
  <section class="pt-24 pb-16 md:pt-28 md:pb-24">
    <div class="container-main max-w-4xl">
      <div class="text-center mb-16 fade-up">
        <span class="section-label mb-4 block">Tentang</span>
        <h1 class="heading-2 text-white mb-4">Tentang WEXPLORE</h1>
        <p class="body-text">Gear Up, Explore More</p>
      </div>

<div class="card p-6 md:p-8 mb-12 fade-up">
  <h2 class="heading-3 text-white mb-4">Cerita Kami</h2>

  <p class="body-text leading-relaxed mb-5">
    WEXPLORE hadir dari keinginan sederhana untuk membuat kegiatan alam bebas lebih mudah dinikmati oleh siapa saja. Kami memahami bahwa tidak semua orang memiliki perlengkapan outdoor sendiri, sementara banyak yang ingin mencoba mendaki, berkemah, atau menjelajahi alam dengan nyaman dan aman.
  </p>

  <p class="body-text leading-relaxed mb-5">
    Karena itu, WEXPLORE hadir sebagai solusi penyewaan perlengkapan outdoor yang praktis, terjangkau, dan terpercaya. Setiap perlengkapan yang kami sediakan dipilih dengan cermat, dirawat secara berkala, dan diperiksa kondisinya sebelum disewakan, agar pelanggan dapat berpetualang dengan lebih tenang dan percaya diri.
  </p>

  <p class="body-text leading-relaxed">
    Kami ingin menjadi lebih dari sekadar tempat penyewaan, tetapi juga teman perjalanan yang siap membantu setiap langkah petualangan Anda. Bagi kami, setiap perjalanan memiliki cerita, dan WEXPLORE ingin menjadi bagian dari cerita tersebut.
  </p>
</div>

      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="card p-6 md:p-8 fade-up">
          <h2 class="heading-3 text-white mb-4">Visi</h2>
          <p class="body-text leading-relaxed">
    Menjadi penyedia jasa penyewaan perlengkapan outdoor terpercaya yang memberikan kemudahan, kenyamanan, dan kualitas terbaik, sehingga semakin banyak orang dapat menikmati petualangan alam dengan aman dan penuh percaya diri.
</p>
        </div>

<div class="card p-6 md:p-8 fade-up">
  <h2 class="heading-3 text-white mb-4">Misi</h2>

  <ul class="space-y-3">
    <li class="flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive-400 shrink-0 mt-1">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="body-text-sm">
        Menyediakan perlengkapan outdoor yang berkualitas dan siap digunakan.
      </span>
    </li>

    <li class="flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive-400 shrink-0 mt-1">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="body-text-sm">
        Memberikan pelayanan yang mudah, cepat, dan ramah.
      </span>
    </li>

    <li class="flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive-400 shrink-0 mt-1">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="body-text-sm">
        Membantu pelanggan memilih perlengkapan yang sesuai dengan kebutuhan.
      </span>
    </li>

    <li class="flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive-400 shrink-0 mt-1">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="body-text-sm">
        Menjadi mitra terpercaya dalam setiap petualangan.
      </span>
    </li>
  </ul>
</div>
      </div>

      <div class="mb-12 fade-up">
        <h2 class="heading-3 text-white mb-8 text-center">Perjalanan Kami</h2>
        <div class="relative">
          <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-px bg-surface-border md:-translate-x-1/2"></div>
          <div class="space-y-8">
            {timeline.map((item, index) => (
              <div class="relative flex items-start gap-6 md:gap-0" style={`transition-delay: ${index * 100}ms`}>
                <div class="w-12 h-12 rounded-full bg-olive-700 border border-olive-600 flex items-center justify-center shrink-0 z-10 md:absolute md:left-1/2 md:-translate-x-1/2">
                  <span class="text-xs font-bold text-white">{index + 1}</span>
                </div>
                <div class={`card p-5 flex-1 md:w-[calc(50%-2rem)] ${index % 2 === 0 ? 'md:ml-auto md:mr-14' : 'md:mr-auto md:ml-14 md:text-right'}`}>
                  <span class="text-accent-500 font-bold text-sm">{item.year}</span>
                  <p class="text-neutral-400 text-sm">{item.event}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="fade-up">
        <h2 class="heading-3 text-white mb-8 text-center">Nilai Perusahaan</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {values.map((value, index) => (
            <div class="card p-5 text-center card-hover" style={`transition-delay: ${index * 80}ms`}>
              <div class="w-12 h-12 rounded-xl bg-olive-800/40 flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-olive-400" set:html={icons[value.icon]} />
              </div>
              <h3 class="text-sm font-semibold text-white mb-2">{value.title}</h3>
              <p class="text-xs text-neutral-500 leading-relaxed">{value.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
