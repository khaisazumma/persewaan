---
import Layout from '../layouts/Layout.astro'
import { fetchSettings } from '../lib/fetchData'

const settings = await fetchSettings()

const contactItems = [
  ...(settings.whatsapp ? [{
    icon: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.432-9.884 9.884-9.884 2.634 0 5.115 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>',
    label: 'WhatsApp',
    value: 'Chat Sekarang',
    href: `https://wa.me/${settings.whatsapp}`,
    color: 'bg-whatsapp/10 text-whatsapp hover:bg-whatsapp/20'
  }] : []),
  ...(settings.instagram ? [{
    icon: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
    label: 'Instagram',
    value: '@wexplore.id',
    href: settings.instagram,
    color: 'bg-neutral-800 text-neutral-300 hover:bg-neutral-700'
  }] : []),
  ...(settings.tiktok ? [{
    icon: '<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>',
    label: 'TikTok',
    value: '@wexplore.id',
    href: settings.tiktok,
    color: 'bg-neutral-800 text-neutral-300 hover:bg-neutral-700'
  }] : []),
  ...(settings.address ? [{
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
    label: 'Alamat',
    value: settings.address,
    href: '#',
    color: 'bg-olive-800/40 text-olive-400 hover:bg-olive-800/60'
  }] : [])
]
---

<Layout title="Kontak — WEXPLORE">
  <section class="pt-24 pb-16 md:pt-28 md:pb-24">
    <div class="container-main max-w-3xl">
      <div class="max-w-2xl mx-auto text-center mb-16 fade-up">
        <span class="section-label mb-4 block">Kontak</span>
        <h1 class="heading-2 text-white mb-4">Hubungi Kami</h1>
        <p class="body-text">Ada pertanyaan? Kami siap membantu Anda!</p>
      </div>

      <div class="space-y-3 mb-8 fade-up">
        {contactItems.map((item, index) => (
          <a
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="flex items-center gap-4 p-4 card rounded-lg group hover:border-olive-700 transition-colors"
            onclick={item.href.startsWith('http') ? "window.trackEvent('contact_click')" : undefined}
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class={`w-12 h-12 rounded-lg flex items-center justify-center shrink-0 transition-colors ${item.color}`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill={item.label === 'WhatsApp' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-neutral-500 mb-0.5">{item.label}</p>
              <p class="text-sm font-semibold text-white group-hover:text-accent-500 transition-colors">{item.value}</p>
            </div>
            {item.href.startsWith('http') && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-neutral-400 transition-colors">
                <path d="M7 7h10v10"/>
                <path d="M7 17 17 7"/>
              </svg>
            )}
          </a>
        ))}
      </div>

      {settings.maps && (
        <a
          href={settings.maps.replace('embed', 'view').replace(/\/embed\?.*?$/, '') || 'https://maps.google.com'}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full"
          onclick="window.trackEvent('maps_click')"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
            <line x1="9" x2="9" y1="3" y2="18"/>
            <line x1="15" x2="15" y1="6" y2="21"/>
          </svg>
          Buka di Google Maps
        </a>
      )}
    </div>
  </section>
</Layout>
